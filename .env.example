# Copy to .env and adjust. Never commit a real .env with secrets.

# Database: SQLite fallback (default, local dev). For Postgres:
# DATABASE_URL=postgresql+psycopg://respira:secret@localhost:5432/respira
DATABASE_URL=

# REQUIRED in production: long random string for JWT signing
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRE_HOURS=8

# Backend / CORS
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
FRONTEND_URL=http://localhost:5173

# Storage of studies/reports (relative paths stored in DB; never leaked to clients)
STORAGE_DIR=
# Retain uploaded X-rays + generated overlays on disk after a saved examination
RETAIN_IMAGES=true
MAX_UPLOAD_MB=15

# Frontend (Vite): backend base URL. Empty string = same-origin (use Vite proxy in dev)
VITE_API_URL=
